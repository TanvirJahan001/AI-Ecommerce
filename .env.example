# Local-only database. Use isolated credentials per environment.
DATABASE_URL=postgresql://store:change-me@localhost:5432/mobile_store
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# bootstrap is one-time and only active when explicitly enabled in development
OWNER_BOOTSTRAP_ENABLED=false
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# Enable only local fictional payment/notification transports.
STORE_DEV_ADAPTERS=false
# REQUIRED for integration tests: distinct disposable database, then isolated schemas
TEST_DATABASE_URL=postgresql://store:change-me@localhost:5432/mobile_store_test

# See .env.supabase.example for private-schema Supabase server configuration.
# Destructive fixture scripts require explicit opt-in only on disposable data:
STORE_TEST_FIXTURES=false

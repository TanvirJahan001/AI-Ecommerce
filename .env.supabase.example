# PRIVATE configuration reference. Copy runtime, migration and audit sections into SEPARATE ignored files.
# Only runtime settings belong in the Next.js process; never commit credentials.
# localhost:8000 is HTTP, not PostgreSQL. Obtain these URLs from the intended installation.
DATABASE_PROVIDER=supabase
DATABASE_URL=postgresql://ecommerce_runtime:REPLACE_PRIVATELY@HOST:PORT/DATABASE
DATABASE_SCHEMA=store_private
# Verify from actual installation configuration; do not infer from port numbers.
DATABASE_CONNECTION_MODE=session
# Use disable only for a confirmed trusted loopback-only connection without TLS.
# For TLS use verify-full and DATABASE_SSL_CA if a private CA is required.
DATABASE_SSL_MODE=disable
# Actual PostgREST exposure list; example only, must be inspected before provisioning.
DATABASE_EXPOSED_SCHEMAS=public,graphql_public
# MIGRATION-ONLY: add to a CLI-only copy of runtime settings, never the web env.
MIGRATION_DATABASE_URL=postgresql://ecommerce_owner:REPLACE_PRIVATELY@HOST:PORT/DATABASE
# AUDIT-ONLY: use in a separate CLI-only file with schema/exposure/TLS/mode settings.
# Read-only privilege audit only; never use administrator credentials in Next.js.
DATABASE_ADMIN_URL=postgresql://ADMIN_ROLE:REPLACE_PRIVATELY@HOST:PORT/DATABASE
# A DISTINCT disposable database, never the configured application database.
TEST_DATABASE_URL=postgresql://TEST_ADMIN:REPLACE_PRIVATELY@HOST:PORT/ISOLATED_TEST_DATABASE
# Preserve existing values during a switch; changing the auth secret can break MFA/session data.
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=PRESERVE_EXISTING_PRIVATE_SECRET
STORE_DEV_ADAPTERS=true
OWNER_BOOTSTRAP_ENABLED=false
STORE_TEST_FIXTURES=false
# No Supabase Auth credentials/SSR helpers or browser commerce grants required.

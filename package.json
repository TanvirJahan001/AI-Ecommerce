{
  "name": "mobile-accessories-store",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/database-command.ts migrate",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "auth:migrate": "tsx scripts/database-command.ts auth",
    "owner:bootstrap": "tsx --env-file=.env.local scripts/bootstrap-owner.ts",
    "owner:reset": "tsx --env-file=.env.local scripts/reset-owner.ts",
    "notifications:run": "tsx --env-file=.env.local scripts/outbox.ts",
    "db:restore-check": "tsx --env-file=.env.local scripts/restore-check.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:auth": "tsx --env-file=.env.local scripts/auth-smoke.ts",
    "test:notifications": "tsx --env-file=.env.local scripts/notification-smoke.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "setup:docker": "tsx scripts/setup-docker.ts",
    "db:up": "docker compose --env-file .local-data/docker/database.env up -d --wait",
    "db:stop": "docker compose --env-file .local-data/docker/database.env stop",
    "db:logs": "docker compose --env-file .local-data/docker/database.env logs --tail=100 db",
    "db:status": "docker compose --env-file .local-data/docker/database.env ps",
    "db:check": "tsx --env-file=.env.local scripts/db-preflight.ts",
    "test:prepare-owner": "tsx --env-file=.env.local scripts/test-owner.ts",
    "format": "prettier --write src scripts tests docs README.md *.ts *.json *.mjs",
    "format:check": "prettier --check src scripts tests docs README.md *.ts *.json *.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "better-auth": "^1.7.23",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "embedded-postgres": "*",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}

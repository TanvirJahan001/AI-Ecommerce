{
  "name": "mobile-accessories-store",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "auth:migrate": "tsx --env-file=.env.local scripts/migrate-auth.ts",
    "owner:bootstrap": "tsx --env-file=.env.local scripts/bootstrap-owner.ts",
    "notifications:run": "tsx --env-file=.env.local scripts/outbox.ts",
    "db:restore-check": "tsx --env-file=.env.local scripts/restore-check.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:auth": "tsx --env-file=.env.local scripts/auth-smoke.ts",
    "test:notifications": "tsx --env-file=.env.local scripts/notification-smoke.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "test:prepare-owner": "tsx --env-file=.env.local scripts/test-owner.ts",
    "format": "prettier --write src scripts tests docs README.md *.ts *.json *.mjs",
    "format:check": "prettier --check src scripts tests docs README.md *.ts *.json *.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.23",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "embedded-postgres": "*",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
